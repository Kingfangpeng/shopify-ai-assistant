# Shopify AI Assistant 本地配置模板（不要提交真实密钥）
APP_NAME=Shopify AI Assistant
APP_VERSION=1.0.0
DEBUG=false
HOST=127.0.0.1
PORT=9901
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=gpt-4o
RAG_MODEL=gpt-4o

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIMENSIONS=768

# Milvus 仅允许本机访问；本轮不启用 Milvus 自身用户鉴权
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000
MILVUS_COLLECTION=shopify_kb
MINIO_ROOT_USER=replace-with-random-user
MINIO_ROOT_PASSWORD=replace-with-long-random-password

# SQLite、认证与本地目录；AUTH_SECRET_KEY 留空时首次启动生成本地随机密钥
DATABASE_URL=sqlite:///./volumes/app/shopify_ai.db
AUTH_SECRET_KEY=
AUTH_COOKIE_NAME=shopify_ai_session
AUTH_SESSION_HOURS=8
AUTH_IDLE_MINUTES=60
AUTH_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
UPLOAD_DIR=./uploads
TRASH_DIR=./uploads/.trash
TRASH_RETENTION_DAYS=7
MAX_UPLOAD_BYTES=10485760

# Shopify 只读 Custom App，固定 GraphQL Admin API 2026-07
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_ACCESS_TOKEN=replace-with-read-only-token
SHOPIFY_DEMO_MODE=false
SHOPIFY_LOW_STOCK_THRESHOLD=10
# 最小 scopes：read_orders, read_products, read_inventory, read_customers, read_discounts
# 超过 60 天订单另需 read_all_orders；弃购接口还需店铺/API 权限支持。

RAG_TOP_K=3
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100
MAX_PLAN_STEPS=8
MAX_REPLAN_COUNT=3

# 本轮关闭 Facebook/Google Ads；旧实现不启动、也不注册工具
ADS_ENABLED=false
