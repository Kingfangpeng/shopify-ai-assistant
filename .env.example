# Shopify AI Assistant - Environment Variables
# Copy this file to .env and fill in your credentials

# ── Application ──────────────────────────────────────────
APP_NAME=Shopify AI Assistant
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=9901

# ── LLM Provider (choose one) ────────────────────────────
# OpenAI
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-4o
RAG_MODEL=gpt-4o

# DeepSeek (uncomment to use)
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-chat
# RAG_MODEL=deepseek-chat

# Qwen / Aliyun DashScope (uncomment to use)
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-your-dashscope-key
# LLM_MODEL=qwen-max
# RAG_MODEL=qwen-max

# ── Embedding (local Ollama) ──────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIMENSIONS=768

# ── Milvus Vector Database ────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000
MILVUS_COLLECTION=shopify_kb

# ── RAG Settings ──────────────────────────────────────────
RAG_TOP_K=3
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# ── Shopify Store ─────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2024-10
SHOPIFY_ACCESS_TOKEN=shpat_your_token_here

# ── Facebook Marketing API ────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_AD_ACCOUNT_ID=act_000000000

# ── Google Ads API ────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── MCP Servers ───────────────────────────────────────────
MCP_SHOPIFY_URL=http://localhost:8003/mcp
MCP_ADS_URL=http://localhost:8004/mcp

# ── Agent Behavior ────────────────────────────────────────
MAX_PLAN_STEPS=8
MAX_REPLAN_COUNT=3
